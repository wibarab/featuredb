<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://www.tei-c.org/release/xml/tei/custom/schema/relaxng/tei_odds.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<?xml-model href="http://www.tei-c.org/release/xml/tei/custom/schema/relaxng/tei_odds.rng" type="application/xml"
	schematypens="http://purl.oclc.org/dsdl/schematron"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xmlns:sch="http://purl.oclc.org/dsdl/schematron">
    <teiHeader>
        <fileDesc>
            <titleStmt>
                <title>WIBARAB profiles ODD</title>
                <principal>
                    <name type="person" ref="dmp:SP">Stephan Procházka</name>
                </principal>
                <author>
                    <name type="person" ref="dmp:KS">Kinga Sramó</name>
                    <name type="person" ref="dmp:DS">Daniel Schopper</name>
                </author>
            </titleStmt>
            <publicationStmt>
                <publisher>Austrian Centre for Digital Humanities and Cultural Heritage</publisher>
                <date>2026</date>
                <availability>
                    <licence>CC BY 4.0</licence>
                </availability>
            </publicationStmt>
            <sourceDesc>
                <p>This is a born digital document.</p>
            </sourceDesc>
        </fileDesc>
        <revisionDesc>
            <change who="#KS" when="2026-09-15">created document</change>
        </revisionDesc>
    </teiHeader>
    <text>
        <body>
            <div>
                <head>Documentation</head>
                <p>
                    This document describes the schema of the WIBARAB profiles of Arabic varieties.
                </p>
            </div>
            <div>
                <head>Formal Specification</head>
                <schemaSpec ident="wibarab-profiles" start="TEI">
                    <moduleRef key="header" include="teiHeader fileDesc titleStmt publicationStmt availability rendition profileDesc langUsage encodingDesc tagsDecl revisionDesc change listPrefixDef prefixDef" />
                    <moduleRef key="core" include="address author editor desc graphic head hi label note p publisher pubPlace ref respStmt resp rs series title" />
                    <moduleRef key="tei" />
                    <moduleRef key="namesdates" include="geo listPlace place persName" />
                    <moduleRef key="textstructure" include="body div TEI text" />
                    <moduleRef key="figures" include="figure" />
                    <classRef key="att.global.linking" />
                    <!-- imports from Lex0 -->
                    <moduleRef key="derived-module-TEILex0" source="https://raw.githubusercontent.com/wibarab/featuredb/main/802_tei_odd/lex-0.compiled.odd" />
                    <moduleRef key="header" include="sourceDesc language" source="https://raw.githubusercontent.com/wibarab/featuredb/main/802_tei_odd/lex-0.compiled.odd" />
                    <moduleRef key="corpus" include="settingDesc channel" source="https://raw.githubusercontent.com/wibarab/featuredb/main/802_tei_odd/lex-0.compiled.odd" />
                    <elementRef key="personGrp" source="https://raw.githubusercontent.com/wibarab/featuredb/main/802_tei_odd/lex-0.compiled.odd" />
                    <!-- make date part of publicationStmtPart.detail again -->
                    <!-- in order reconcile publicationStmt content model from TEI P5 with date from Lex0 -->
                    <elementSpec ident="date" mode="change">
                        <classes mode="change">
                            <memberOf key="model.publicationStmtPart.detail" mode="add" />
                        </classes>
                    </elementSpec>
                    <elementSpec ident="p" mode="change" module="core">
                        <content>
                            <alternate minOccurs="1" maxOccurs="unbounded">
                                <textNode />
                                <elementRef key="hi" />
                                <elementRef key="rs" />
                                <elementRef key="ref" />
                                <elementRef key="geo" />
                            </alternate>
                        </content>
                    </elementSpec>
                    <elementSpec ident="head" module="core" mode="change">
                        <desc>
                            head elements are either:
                            (1) VICAV Profile headings (containing 1 profile image + 1-n names with optional labels),
                            (2) figure captions (containing plain text or a hyperlink pointing to the source of the image)
                        </desc>
                        <content>
                            <alternate>
                                <sequence preserveOrder="true">
                                    <!-- profile image -->
                                    <elementRef key="figure" minOccurs="1" maxOccurs="1" />
                                    <sequence preserveOrder="true" maxOccurs="unbounded">
                                        <elementRef key="label" minOccurs="0" maxOccurs="1" />
                                        <!-- we moved the names to the geolist, so commenting this out for now -->
                                        <!-- <elementRef key="name" minOccurs="1" maxOccurs="1" /> -->
                                    </sequence>
                                </sequence>
                                <!-- or just (non-empty) plain text -->
                                <textNode />
                                <!-- or a hyperlink -->
                                <elementRef key="ref" />
                            </alternate>
                        </content>
                    </elementSpec>
                    <elementSpec ident="div" module="core" mode="change">
                        <attList>
                            <attDef ident="type" mode="replace">
                                <valList type="closed">
                                    <valItem ident="dictionaries">
                                        <desc>lists dictionaries available for the variety described by the profile</desc>
                                    </valItem>
                                    <valItem ident="audioData">
                                        <desc>
                                            lists audia material available for the variety described by the
                                            profile
                                        </desc>
                                    </valItem>
                                    <valItem ident="sampleText">
                                        <desc>contains a sample text of the variety described by the profile</desc>
                                    </valItem>
                                    <valItem ident="lingFeatures">
                                        <desc>
                                            contains a formal description of the linguistic features of the variety
                                            described by the profile
                                        </desc>
                                    </valItem>
                                    <valItem ident="bibliography">
                                        <desc>contains a bibliography of the variety described by the profile</desc>
                                    </valItem>
                                    <valItem ident="researchHistory">
                                        <desc>
                                            describes the research history on the variety described by the
                                            profile
                                        </desc>
                                    </valItem>
                                    <valItem ident="typology">
                                        <desc>describes the typology of the variety described by the profile</desc>
                                    </valItem>
                                    <valItem ident="textBooks">
                                        <desc>lists text books available for the variety described by the profile</desc>
                                    </valItem>
                                    <valItem ident="general">
                                        <desc>
                                            provides a general description of the variety described by the
                                            profile
                                        </desc>
                                    </valItem>
                                </valList>
                            </attDef>
                        </attList>
                    </elementSpec>
                    <!-- ref checks -->
                    <elementSpec ident="bibl" mode="change">
                        <constraintSpec ident="profile-references" scheme="schematron">
                            <constraint>
                                <sch:ns prefix="tei" uri="http://www.tei-c.org/ns/1.0" />
                                <sch:rule context="tei:bibl/@corresp">
                                    <sch:extends rule="reference" />
                                </sch:rule>
                                <sch:rule context="tei:rs[@type = 'bibl']/@ref">
                                    <sch:extends rule="reference" />
                                </sch:rule>
                                <sch:rule context="tei:place/@sameAs">
                                    <sch:extends rule="reference" />
                                </sch:rule>
                                <sch:rule context="tei:personGrp/@corresp">
                                    <sch:extends rule="reference" />
                                </sch:rule>
                                <sch:rule context="tei:change/@who">
                                    <sch:extends rule="reference" />
                                </sch:rule>
                                <sch:rule id="reference" abstract="true">
                                    <sch:let name="idRef" value="." />
                                    <sch:let name="localID" value="if (matches($idRef,'^#')) then substring-after($idRef,'#') else ()" />
                                    <sch:let name="prefixDefs" value="root()//tei:prefixDef" />
                                    <sch:let name="prefixRegex" value="concat('^(',string-join($prefixDefs/@ident,'|'),'):(.+)$')" />
                                    <sch:let name="prefixMatch" value="if (exists($prefixDefs)) then analyze-string($idRef, $prefixRegex)//*:group[1] else ()" />
                                    <sch:let name="referenceMatch" value="if (exists($prefixDefs)) then analyze-string($idRef, $prefixRegex)//*:group[2] else ()" />
                                    <sch:let name="prefixDef" value="if (exists($prefixMatch)) then $prefixDefs[@ident = $prefixMatch] else ()" />
                                    <sch:let name="prefixGroups" value="if (exists($prefixMatch)) then analyze-string($referenceMatch, $prefixDef/@matchPattern)//*:group else ()" />
                                    <sch:let name="grpr1" value="if (exists($prefixGroups[@nr = '1'])) then replace($prefixDef/@replacementPattern,'\$1', $prefixGroups[@nr = '1']) else $prefixDef/@replacementPattern" />
                                    <sch:let name="grpr2" value="if (exists($prefixGroups[@nr = '2'])) then replace($grpr1,'\$2', $prefixGroups[@nr = '2']) else $grpr1" />
                                    <sch:let name="targetRaw" value="if ($localID != '') then $idRef else if (exists($prefixDef)) then $grpr2 else $idRef" />
                                    <sch:let name="target" value="translate($targetRaw,'\','/')" />
                                    <sch:let name="targetResolves" value="if ($localID != '') then exists(root()//*[@xml:id = $localID]) else if (matches($idRef,'^(http|https)')) then true() else doc-available(resolve-uri($target, base-uri($idRef)))" />
                                    <sch:report test="$target = ''">unexpected target "<sch:value-of select="$idRef" />" in reference <sch:value-of select="local-name($idRef)" />
                                </sch:report>
                                <sch:assert test="$targetResolves">the target "<sch:value-of select="$target" />" of pointer "<sch:value-of select="$idRef" />" cannot be resolved</sch:assert>
                            </sch:rule>
                        </constraint>
                    </constraintSpec>
                </elementSpec>
            </schemaSpec>
        </div>
    </body>
</text>
</TEI>