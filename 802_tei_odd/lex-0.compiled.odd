    <profileDesc>
      <textClass default="false">
        <keywords>
          <list>
            <item>TEI</item>
            <item>XML</item>
            <item>encoding</item>
            <item>lexicography</item>
            <item>dictionaries</item>
            <item>Digital Humanities</item>
          </list>
        </keywords>
      </textClass>
      <abstract>
        <p part="N">TEI Lex-0 is a community-driven subset of the Text Encoding Initiative (TEI)
          Guidelines that defines a constrained, interoperable model for encoding dictionaries and
          lexical resources. It combines human-readable guidelines with machine-actionable RELAX NG
          schemas to support consistent data creation, validation, and reuse in electronic
          lexicography and the digital humanities.</p>
      </abstract>
    </profileDesc>
    <revisionDesc status="draft">
      <listChange ordered="true">
        <listChange n="0.9.5" xml:id="v0.9.5" ordered="true">
          <change when="2026-02-08" type="docs" status="draft">Added documentation on encoding
            condensed forms a là "leleti (sě)".</change>
          <change type="spec" status="draft">Added <ref target="#TEI.model.languageProfile"
              >model.languageProfile</ref> to better structure <gi scheme="TEI">language</gi> as per
              <ref target="https://github.com/DARIAH-ERIC/lexicalresources/issues/245"
            >#245</ref>.</change>
          <!--<change type="spec">Added <gi>ruby</gi> annotation support as per <ref
                            target="https://github.com/DARIAH-ERIC/lexicalresources/issues/225"
                            >#225</ref></change>-->
          <change type="spec" status="draft">Added <gi scheme="TEI">measure</gi> (to be used, for
            instance, within <gi scheme="TEI">extent</gi> in <gi scheme="TEI">fileDesc</gi> as per
              <ref target="https://github.com/DARIAH-ERIC/lexicalresources/issues/257"
            >#257</ref>.</change>
          <change type="xproc" status="draft">Added a temporary step to fix <att scheme="TEI"
              >xml:base</att> and <att scheme="TEI">xml:lang</att> issues in xincluded examples as
            per <ref target="https://github.com/DARIAH-ERIC/lexicalresources/issues/256"
            >#256</ref></change>
          <change type="spec" status="draft">Deprecated <code rend="language-xpath"
              >gram[@type="government"]</code> in favor of <code rend="language-xpath"
              >gram[@type="construction"]</code> as per <ref
              target="https://github.com/DARIAH-ERIC/lexicalresources/issues/254"
            >#254</ref></change>
          <change type="spec" status="draft">Refactored model classes to fix XSD UPA violations as
            per <ref target="https://github.com/DARIAH-ERIC/lexicalresources/issues/223"
            >#223</ref>.</change>
          <change type="docs" status="draft">Minor corrections in the documentation</change>
          <change type="docs" status="draft">Introduced the labeling of P5 and Lex-0 examples in the
            specification to avoid confusion</change>
          <change type="docs" status="draft">Added a secion on documenting <ref
              target="#language-profile">language profiles</ref> to the <hi rend="italic"
              >Guidelines</hi></change>
          <change type="spec" status="draft">Included <gi scheme="TEI">listPlace</gi> to be used in
              <gi scheme="TEI">settingDesc</gi> as part of <ref target="#TEI.model.languageProfile"
              >model.languageProfile</ref></change>
        </listChange>
        <listChange n="0.9.4" corresp="releases/v0.9.4/" ordered="true">
          <change when="2024-05-12" type="xproc" status="draft">fix documentation build on macOS and
            Windows in oXygen XML Editor</change>
          <change type="spec" status="draft">added <code>degree</code> as <gi scheme="TEI"
              >gram</gi><att scheme="TEI">type</att> value</change>
          <change type="docs" status="draft">fixed some typographical errors in the
            documentation</change>
        </listChange>
        <listChange n="0.9.3" ordered="true">
          <change when="2024-02-12" type="spec" status="draft"><gi scheme="TEI">catDesc</gi><hi
              rend="italic">must</hi> contain a <gi scheme="TEI">term</gi></change>
          <change type="spec" status="draft">switch to using the external TEI add-on in oXygen when
            generating schema and documentation</change>
          <change type="spec" status="draft">fix the mismatch in <gi scheme="TEI">usg</gi> types
            between the specification and documentation (use <code>temporal</code> instead of
              <code>time</code></change>
          <change type="spec" status="draft">require <gi scheme="TEI">listBibl</gi> in <gi
              scheme="TEI">sourceDesc</gi> with three suggested type values:
              <code>dictionaries</code>, <code>corpora</code> and <code>literature</code></change>
        </listChange>
        <listChange n="0.9.2" ordered="true">
          <change when="2023-04-22" type="xproc" status="draft">switch to using oXygen's TEI
            framework when generating schema and documentation</change>
          <change type="spec" status="draft">allow <gi scheme="TEI">list</gi> and <gi scheme="TEI"
              >item</gi> because lists feature prominently in dictionary front matter</change>
          <change type="spec" status="draft">introduce <ref target="#TEI.model.lexicalInter"
              >model.lexicalInter</ref> (based on <ref target="#TEI.model.inter">model.inter</ref>),
              <ref target="#TEI.model.lexicalPhrase">model.lexicalPhrase</ref> (based on <ref
              target="#TEI.model.phrase">model.phrase</ref>) and <ref
              target="#TEI.macro.lexicalParaContent">macro.lexicalParaContent</ref> (based on <ref
              target="#TEI.macro.paraContent">macro.paraContent</ref>) to make it easier to simplify
            the content model of various dictionary elements</change>
          <change type="spec" status="draft">remove <ref target="#TEI.model.listLike"
              >model.listLike</ref> from <ref target="#TEI.model.lexicalInter"
              >model.lexicalInter</ref></change>
          <change type="html" status="draft">link version number in the menu to revision
            history</change>
          <change type="spec" status="draft">allow <gi scheme="TEI">abbr</gi> and <gi scheme="TEI"
              >expan</gi> so that they can be used in lists of abbreviations in dictionary front
            matter</change>
          <change type="spec" status="draft">introduced <code>valency</code> as a suggested value in
              <code rend="language-xpath">gram[@type="valency"]</code></change>
          <change type="spec" status="draft">introduced <code rend="language-xpath"
              >gram[@type="government"]</code> and clarified the difference from <code
              rend="language-xpath">gram[@type="colloc"]</code>. See sections on <ref
              target="#typology-of-gram">Typology of <code>gram</code></ref> and <ref
              target="#collocates">Collocates</ref></change>
          <change type="spec" status="draft">made <code rend="language-xpath">@type</code> mandatory
            on <gi scheme="TEI">TEI</gi></change>
          <change type="spec" status="draft">add <gi scheme="TEI">principal</gi> and <gi
              scheme="TEI">affiliation</gi> for more robust metadata in the <gi scheme="TEI"
              >teiHeader</gi></change>
        </listChange>
        <listChange n="0.9.1" ordered="true">
          <change when="2021-03-24" type="html" status="draft">fix namespace issues in html
            output</change>
          <change type="docs" status="draft">add new examples to the <ref target="#header"
              >Header</ref> section</change>
          <change type="docs" status="draft">add section on <ref target="#HierarchicalUsageLabels"
              >hierarchichal usage labels</ref></change>
          <change type="spec" status="draft">allow <gi scheme="TEI">taxonomy</gi>, <gi scheme="TEI"
              >category</gi> and <gi scheme="TEI">catDesc</gi> in <gi scheme="TEI"
            >classDecl</gi></change>
          <change type="docs" status="draft">move the <ref target="#specification"
              >specification</ref> to a different webpage for quicker loading</change>
        </listChange>
        <listChange n="0.9.0" ordered="true">
          <change when="2021-09-26" type="docs" status="draft">add section on <ref target="#header"
              >TEI Header</ref></change>
          <change type="docs" status="draft">correction of various misspellings</change>
          <change type="spec" status="draft">add <gi scheme="TEI">monogr</gi> (needed for <gi
              scheme="TEI">biblStruct</gi>)</change>
          <change type="spec" status="draft">add <gi scheme="TEI">forename</gi> and <gi scheme="TEI"
              >surname</gi> for more fine-grained bibliographic information</change>
          <change type="spec" status="draft">add <gi scheme="TEI">editorialDecl</gi></change>
          <change type="spec" status="draft">add <gi scheme="TEI">email</gi> to make possible
            contact information in the header</change>
          <change type="spec" status="draft">require <gi scheme="TEI">availability</gi> in <gi
              scheme="TEI">publicationStmt</gi> to provide <gi scheme="TEI">licence</gi></change>
          <change type="spec" status="draft">make <gi scheme="TEI">sourceDesc</gi> optional</change>
          <change type="spec" status="draft">allow only <gi scheme="TEI">biblStruct</gi> in <gi
              scheme="TEI">sourceDesc</gi></change>
          <change type="spec" status="draft">make <ref
              target="#TEI.model.publicationStmtPart.agency">model.publicationStmtPart.agency</ref>
            unbound to allow both <gi scheme="TEI">publisher</gi> and <gi scheme="TEI"
              >authority</gi> in <gi scheme="TEI">publicationStmt</gi></change>
          <change type="spec" status="draft">add <att scheme="TEI">role</att> to <gi scheme="TEI"
              >authority</gi> with suggested values: <val>funder</val>, <val>sponsor</val>,
              <val>rightsHolder</val></change>
          <change type="spec" status="draft">require <gi scheme="TEI">language</gi>, <gi
              scheme="TEI">langUsage</gi> and <gi scheme="TEI">profileDesc</gi></change>
          <change type="spec" status="draft">add <att scheme="TEI">role</att> to <gi scheme="TEI"
              >language</gi> with a closed list of values: <val>objectLanguage</val>,
              <val>workingLanguage</val>, <val>sourceLanguage</val>,
            <val>targetLanguage</val></change>
        </listChange>
      </listChange>
    </revisionDesc>
  </teiHeader>
  <text>
    <front>
      <div xml:id="home" xml:base="includes/00__index.xml" xml:lang="" part="N" org="uniform"
        sample="complete">
        <p part="N">TEI Lex-0 is both a technical specification and a set of community-based
          recommendations for encoding machine-readable dictionaries. It helps you create, analyze,
          and share lexical resources that are interoperable, sustainable, and fit for purpose.</p>
        <egXML xmlns="http://www.tei-c.org/ns/Examples" source="#Johnson1775"
          rend="unwrapped tb-floated tb-smaller" valid="true"><entry xml:id="SJ.DEL" xml:lang="en"
            type="mainEntry" xml:base="../examples/examples.stripped.xml"><form type="lemma"
                ><orth>Lexicographer</orth></form><gramGrp><gram type="pos" norm="noun"
              >n.s.</gram></gramGrp><sense xml:id="SJ.GDEL.l20s4b"><def>A writer of dictionaries; a
                harmless drudge, that busies himself in tracing the original, and detailing the
                signification of words.</def><cit type="example"><quote>Commentators and <ref
                    type="oRef">lexicographers</ref> acquainted with the Syriac language, have given
                  these hints in their writings on scripture.</quote><bibl ref="#IW.IoM"
                  >Watts.</bibl></cit></sense></entry></egXML>
        <div xml:id="home.quickstart" part="N" org="uniform" sample="complete">
          <head>Quickstart</head>
          <p part="N">To start using Lex-0 in your projects, you'll need a schema-aware XML editor
            and one of our schemas: <list>
              <item><ref target="schema/lex-0.rng">Relax NG (RNG)</ref></item>
              <item><ref target="schema/lex-0.rnc">Relax NG Compact (RNC)</ref></item>
              <item><ref target="schema/lex-0.xsd">XML Schema (XSD)</ref></item>
            </list></p>
          <p part="N">Lex-0 is versioned, so users can choose between the stable, citable release
            and the latest in‑progress updates:<list>
              <item><ref target="https://lex-0.org" rend="allow-absolute" type="external-site"
                  >lex-0.org</ref> (official release) and</item>
              <item><ref target="https://dev.lex-0.org" rend="allow-absolute" type="external-site"
                  >dev.lex-0.org</ref> (ongoing development).</item>
            </list>Starting with v0.9.4, users can also easily consult previous, archived <ref
              target="releases">releases</ref>. </p>
          <p part="N">If you are new to the world of TEI and XML, in general, or need a refresher on
            how to validate TEI files, see <ref target="#faq.get-started">FAQ → Getting
              Started</ref></p>
        </div>
        <div xml:id="home.howTo" part="N" org="uniform" sample="complete">
          <head>How to use the <hi rend="italic">Guidelines</hi></head>
          <p part="N">The narrative chapters of these <hi rend="italic">Guidelines</hi> explain <hi
              rend="italic">why</hi> TEI Lex-0 recommends certain practices, <hi rend="italic"
              >what</hi> those practices mean for lexicographic work, and <hi rend="italic">how</hi>
            to apply them in real encoding situations. Each chapter focuses on a specific type of
            lexicographic content, covering rationale, examples and guidance for the consistent
            encoding of <ref target="#entries">entries</ref>, <ref target="#forms">forms</ref>, <ref
              target="#senses">senses</ref>, <ref target="#translations">translations</ref>, <ref
              target="#cross-references">cross-references</ref> and <ref target="#usage">usage
              labels</ref>.</p>
          <p part="N">The technical <ref target="#specification">Specification</ref> is the <hi
              rend="italic">reference manual</hi> (and, effectively, the “grammar”) of Lex-0. When
            you need to answer concrete questions like “What elements are allowed within <gi
              scheme="TEI">sense</gi>?”, “Which attributes are permitted on <gi scheme="TEI"
              >form</gi>?”, or “What types of values are valid in <att scheme="TEI">target</att>?”,
            the <hi rend="italic">Specification</hi> is the first place to look. </p>
          <p part="N">The chapter on the <ref target="#community">Community</ref> explains how TEI
            Lex-0 evolved and the people behind it, while the <ref target="#faq">FAQs</ref> provide
            quick answers on <ref target="#faq.whyLex-0">why</ref> Lex-0 exists, <ref
              target="#faq.lex-0-vs-TEI">how</ref> it relates to TEI P5, and how to <ref
              target="#faq.get-started">get started</ref> with validation and tooling. They also
            cover issues such as where to <ref target="#faq.who-to-ask">ask questions</ref>, how to
              <ref target="#faq.how-to-contribute">get involved</ref> with the development, how <ref
              target="#faq.how-to-cite">to cite</ref> the <hi rend="italic">Guidelines</hi> etc.</p>
        </div>
        <divGen type="revision-history"/>
      </div>
    </front>
    <body>
      <div xml:id="header" xml:base="includes/05__header.xml" xml:lang="" part="N" org="uniform"
        sample="complete">
        <head>Header</head>
        <p part="N">A lexical resource encoded in TEI Lex-0 must, like any TEI file, start with the
          root <gi scheme="TEI">TEI</gi> element, which, in turn, must contain a <gi scheme="TEI"
            >teiHeader</gi> element.</p>
        <p part="N">TEI Lex-0, unlike TEI P5, however, requires the <code rend="language-xpath"
            >@type</code> attribute on the root <code rend="language-xpath">/TEI</code> with the
          value "lex-0". </p>
        <p part="N">A TEI header contains information about the lexical resource itself, its
          source(s), its encoding, and its revisions. Proper, structured metadata of this kind is
          equally important for scholars using the resource, for software processing them, and for
          cataloguers in libraries and archives.</p>
        <p part="N">The TEI header of a lexical resource has five major parts:<list>
            <item>a <hi rend="italic">file description</hi>, tagged <gi scheme="TEI">fileDesc</gi>,
              provides a full bibliographic description of the electronic lexical resource itself as
              well as the source(s), analogue or digital, from which it may have been derived. For
              details, see section <ref target="#file-description">File Description</ref> below. </item>
            <item>an <hi rend="italic">encoding description</hi>, tagged <gi scheme="TEI"
                >encodingDesc</gi>, describes the relationship between the electronic resource and
              its source(s). It allows for detailed description of whether (or how) the electronic
              resource was produced, transcribed or normalized, how the encoder resolved ambiguities
              in the source, what levels of encoding or analysis were applied etc.</item>
            <item>a <hi rend="italic">profile description</hi>, tagged <gi scheme="TEI"
                >profileDesc</gi>, contains classificatory and contextual information about the
              lexical resource including its object and working languages.</item>
            <item>a <hi rend="italic">container for external metadata</hi>, tagged <gi scheme="TEI"
                >xenoData</gi>, contains metadata from non-TEI schemas, for instance Dublin Core,
              MARCXML or MODS, if available.</item>
            <item>a <hi rend="italic">revision history</hi>, tagged <gi scheme="TEI"
                >revisionDesc</gi>, contains a list of changes made during the development of the
              lexical resource, both before and after its official release. </item>
          </list></p>
        <p part="N">Of these, two elements are required in TEI Lex-0: <gi scheme="TEI">fileDesc</gi>
          and <gi scheme="TEI">profileDesc</gi>. It is highly recommended to include additional
          information in <gi scheme="TEI">encodingDesc</gi>. It is also an example of good practice
          to record changes in <gi scheme="TEI">revisionDesc</gi>. </p>
        <div xml:id="file-description" part="N" org="uniform" sample="complete">
          <head>File description</head>
          <p part="N">The bibliographic description of the given machine-readable lexical resource
            is absolutely essential for identifying the basic information about the resource itself,
            its creators and publishers as well as the conditions under which it is made available
            to the public. </p>
          <p part="N"> The elements that make up <gi scheme="TEI">fileDesc</gi> are: <specList>
              <specDesc key="titleStmt"/>
              <specDesc key="editionStmt"/>
              <specDesc key="extent"/>
              <specDesc key="publicationStmt"/>
              <specDesc key="seriesStmt"/>
              <specDesc key="sourceDesc"/>
            </specList></p>
          <p part="N"><gi scheme="TEI">fileDesc</gi> is a mandatory element in plain TEI as well,
            but in TEI Lex-0 there are some additional constraints and recommendations related to
            the content of this element.</p>
          <p part="N"><list>
              <item>In <gi scheme="TEI">titleStmt</gi>, TEI Lex-0 <hi rend="italic">recommends</hi>
                the use of <att scheme="TEI">type</att> on <gi scheme="TEI">title</gi> (with values
                either <val>full</val> or <val>abbr</val>) to record both the full bibliographic
                title of the lexicographic resource and the preferred abbreviated title for easy
                reference, should one exist. <egXML xmlns="http://www.tei-c.org/ns/Examples"
                  valid="true"><titleStmt>
                    <title type="full">Lexicon Serbico-Germanico-Latinum</title>
                    <title type="abbr">LSGL</title>
                  </titleStmt></egXML></item>
              <item>In <gi scheme="TEI">titleStmt</gi>, TEI Lex-0 <hi rend="italic">recommends</hi>
                the use of <gi scheme="TEI">persName</gi> and <gi scheme="TEI">orgName</gi> to
                distinguish between the names of persons and organizations. This is especially
                important since in some cases, the name of an institution is used to take up the
                collective authorship of a work.</item>
              <item>When using <gi scheme="TEI">persName</gi>, TEI Lex-0 <hi rend="italic"
                  >recommends</hi> to further structure the name with elements <gi scheme="TEI"
                  >forename</gi> and <gi scheme="TEI">surname</gi>.</item>
              <item>In <gi scheme="TEI">publicationStmt</gi>, TEI Lex-0 <hi rend="italic"
                  >requires</hi> the use of <gi scheme="TEI">availability</gi> to record the <gi
                  scheme="TEI">licence</gi> of the given lexicographic resource. In other words, a
                TEI Lex-0 <hi rend="italic">must</hi> include explicit information on the conditions
                under which the given resource can be used. <egXML
                  xmlns="http://www.tei-c.org/ns/Examples" source="#StčS" valid="true"
                    ><publicationStmt xml:base="../examples/headers/St%C4%8DS.stripped.xml">
                    <publisher>Ústav pro jazyk český AV ČR, v. v. i.</publisher>
                    <pubPlace>Praha</pubPlace>
                    <availability>
                      <licence target="https://creativecommons.org/licenses/by/4.0/">Creative
                        Commons Attribution 4.0 International (CC BY 4.0)</licence>
                    </availability>
                  </publicationStmt></egXML></item>
              <item>In addition to <gi scheme="TEI">publisher</gi> and <gi scheme="TEI"
                  >distributor</gi>, the <gi scheme="TEI">publicationStmt</gi> in TEI Lex-0 <hi
                  rend="italic">may</hi> include information on any other <gi scheme="TEI"
                  >authority</gi> responsible for creating or making the resource available. </item>
              <item>If using <gi scheme="TEI">authority</gi>, TEI Lex-0 <hi rend="italic"
                  >requires</hi> the use of <att scheme="TEI">role</att> with values
                  <val>funder</val>, <val>sponsor</val> or <val>rightsHolder</val>.</item>
            </list></p>
          <div xml:id="header.source-description" part="N" org="uniform" sample="complete">
            <head>Source description</head>
            <p part="N">In TEI Lex-0, <gi scheme="TEI">sourceDesc</gi> is an optional element.
              Born-digital resources or those which cannot be properly sourced do not require a <gi
                scheme="TEI">sourceDesc</gi>. </p>
            <p part="N">If a resource <hi rend="italic">is</hi> sourced, <gi scheme="TEI"
                >sourceDesc</gi> in TEI Lex-0 requires that the sources be grouped in <gi
                scheme="TEI">listBibl</gi> elements: <list>
                <item><code>&lt;listBibl type="dictionaries"&gt;&lt;/listBibl&gt;</code> lists all
                  the dictionaries that were used as a source for the given dictionary; if you are
                  retrodigitizing a print dictionary, your <gi scheme="TEI">listBibl</gi> may
                  include only one <gi scheme="TEI">biblStruct</gi> with the bibliographic
                  information about your print source;</item>
                <item><code>&lt;listBibl type="literature"&gt;&lt;/listBibl&gt;</code> groups all
                  the literature: for instance, all the sources used by the dictionary author to
                  illustrate examples;</item>
                <item><code>&lt;listBibl type="corpora"&gt;&lt;/listBibl&gt;</code> groups the
                  information on all the corpora that were used in the production of the given
                  lexicographic resource.</item>
              </list></p>
            <p part="N">TEI Lex-0 requires the use of <gi scheme="TEI">biblStruct</gi> for
              structuring bibliographic information about each individual source. This, too, is a
              departure from vanilla TEI which is more permissive in this respect. <list
                type="examples">
                <item><egXML xmlns="http://www.tei-c.org/ns/Examples" source="#VOLP" valid="true"
                      ><sourceDesc xml:base="../examples/headers/VOLP.stripped.xml">
                      <listBibl type="dictionaries">
                        <biblStruct>
                          <monogr>
                            <title>Vocabulário Ortográfico da Língua Portuguesa</title>
                            <author><orgName>Academia das Ciências</orgName></author>
                            <imprint>
                              <publisher>Imprensa Nacional de Lisboa</publisher>
                              <date>1940</date>
                            </imprint>
                            <extent>
                              <measure unit="volumes" quantity="1">1 volume</measure>
                              <measure unit="pages" quantity="821">821 pp.</measure>
                            </extent>
                          </monogr>
                        </biblStruct>
                      </listBibl>
                    </sourceDesc></egXML></item>
                <item><egXML xmlns="http://www.tei-c.org/ns/Examples" source="#EtymWB-XML"
                    valid="true"><sourceDesc xml:base="../examples/headers/EtymWB-XML.stripped.xml">
                      <listBibl type="dictionaries">
                        <biblStruct>
                          <monogr>
                            <author><persName><forename>Wolfgang</forename><surname>Pfeifer</surname></persName></author>
                            <title>Etymologisches Wörterbuch des Deutschen</title>
                            <edition>2</edition>
                            <imprint>
                              <publisher>Akademie Verlag</publisher>
                              <pubPlace>Berlin</pubPlace>
                              <date>1993</date>
                              <note>with additional notes by the author</note>
                            </imprint>
                          </monogr>
                        </biblStruct>
                      </listBibl>
                    </sourceDesc></egXML></item>
                <item><egXML xmlns="http://www.tei-c.org/ns/Examples" source="#StčS" valid="true"
                      ><sourceDesc xml:base="../examples/headers/St%C4%8DS.stripped.xml">
                      <listBibl type="dictionaries">
                        <biblStruct>
                          <monogr>
                            <title level="m" type="main">Staročeský slovník</title>
                            <title level="m" type="sub">[Seš.] 1–26: na – při</title>
                            <editor><persName><forename>Bohuslav</forename><surname>Havránek</surname></persName></editor>
                            <editor><persName><forename>Vladimír</forename><surname>Šmilauer</surname></persName></editor>
                            <editor><persName><forename>Václav</forename><surname>Křístek</surname></persName></editor>
                            <editor><persName><forename>Jan</forename><surname>Petr</surname></persName></editor>
                            <editor><persName><forename>Igor</forename><surname>Němec</surname></persName></editor>
                            <editor><persName><forename>Emanuel</forename><surname>Michálek</surname></persName></editor>
                            <editor><persName><forename>Jaroslava</forename><surname>Pečírková</surname></persName></editor>
                            <imprint>
                              <date>1968–2008</date>
                              <publisher>Academia</publisher>
                              <pubPlace>Praha</pubPlace>
                            </imprint>
                          </monogr>
                        </biblStruct>
                        <biblStruct>
                          <monogr>
                            <title level="m" type="main">Slovník staročeský</title>
                            <title level="m" type="sub">A – J</title>
                            <author><persName><forename>Jan</forename><surname>Gebauer</surname></persName></author>
                            <edition>druhé, nezměněné vydání</edition>
                            <imprint>
                              <date>1970</date>
                              <publisher>Academia</publisher>
                              <pubPlace>Praha</pubPlace>
                            </imprint>
                          </monogr>
                        </biblStruct>
                        <biblStruct>
                          <monogr>
                            <title level="m" type="main">Slovník staročeský</title>
                            <title level="m" type="sub">K – N</title>
                            <author><persName><forename>Jan</forename><surname>Gebauer</surname></persName></author>
                            <edition>druhé, nezměněné vydání</edition>
                            <imprint>
                              <date>1970</date>
                              <publisher>Academia</publisher>
                              <pubPlace>Praha</pubPlace>
                            </imprint>
                          </monogr>
                        </biblStruct>
                      </listBibl>
                    </sourceDesc></egXML></item>
                <item><egXML xmlns="http://www.tei-c.org/ns/Examples" source="#Morais1789"
                    valid="true"><sourceDesc xml:base="../examples/headers/Morais.stripped.xml">
                      <listBibl type="dictionaries">
                        <biblStruct>
                          <monogr>
                            <title level="m" type="main">Diccionario da lingua portugueza composto
                              pelo padre D. Rafael Bluteau, reformado, e accrescentado por Antonio
                              de Moraes Silva, natural do Rio de Janeiro</title>
                            <title level="m" type="sub">A – K</title>
                            <author><persName><forename>António de</forename><surname>Morais
                                  Silva</surname></persName></author>
                            <imprint>
                              <pubPlace>Lisboa</pubPlace>
                              <publisher>Officina de Simão Thaddeo Ferreira</publisher>
                              <pubPlace>Lisboa</pubPlace>
                              <date when="1789">1789</date>
                              <note>Com Licença da Real Meza da Comissão Geral, sobre o Exame, e
                                Censura dos Livros.</note>
                              <note>Vende-ſe na loja de Borel Borel, e Companhia, quaſi defronte da
